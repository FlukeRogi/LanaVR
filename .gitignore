# Everything stays out unless it's listed below. This folder also holds the game's art, decompiled game code,
# licensed sample skies and large test output, none of which may ever reach the repository.
/*

!/.gitignore
!/README.md
!/TESTING.md
!/LanaVR.csproj

!/src/

!/native/
/native/build/

!/install/

!/tests/
/tests/last_run.txt

# Only the mapping. The sample skies go in the test zip, never in the repository.
!/skybox/
/skybox/*
!/skybox/skyboxes.txt

# Only the mod's own tools. Not decomp, dl, ilspy, openxr, symbols or the files copied from the game folder.
!/tools/
/tools/*
!/tools/make_package.ps1
!/tools/mock_runtime.json
!/tools/prof/
